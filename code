<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>3D Gesture Particle App</title>

  <!-- iOS Full Screen Flags -->
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="3D Particles">

  <!-- Manifest Link -->
  <link rel="manifest" href="manifest.json">

  <!-- Inline CSS for styling and fullscreen mobile view -->
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
      -webkit-touch-callout: none;
    }
    body, html {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #050508;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: #ffffff;
    }
    #canvas-container {
      width: 100%;
      height: 100%;
      position: absolute;
      top: 0;
      left: 0;
      z-index: 1;
    }
    #webcam {
      display: none;
    }
    
    /* Overlay Start Screen for WebAudio & Camera Unlock on iOS Safari */
    #start-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(5, 5, 8, 0.92);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      z-index: 100;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 20px;
    }
    .title {
      font-size: 24px;
      font-weight: 700;
      letter-spacing: 2px;
      margin-bottom: 10px;
      background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .subtitle {
      font-size: 14px;
      color: #a0a0b0;
      margin-bottom: 30px;
      max-width: 300px;
      line-height: 1.4;
    }
    .btn-start {
      background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
      color: #fff;
      font-size: 16px;
      font-weight: 600;
      padding: 14px 36px;
      border: none;
      border-radius: 30px;
      box-shadow: 0 10px 20px rgba(0, 114, 255, 0.4);
      cursor: pointer;
      outline: none;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-start:active {
      transform: scale(0.95);
    }
    
    /* On-screen HUD / Controls */
    #hud {
      position: absolute;
      top: env(safe-area-inset-top, 20px);
      left: 15px;
      right: 15px;
      z-index: 10;
      display: flex;
      justify-content: space-between;
      align-items: center;
      pointer-events: none;
    }
    .status-badge {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 20px;
      padding: 6px 14px;
      font-size: 12px;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: #ff4757;
    }
    .dot.active {
      background-color: #2ed573;
      box-shadow: 0 0 8px #2ed573;
    }
    #shape-indicator {
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid rgba(0, 242, 254, 0.3);
      color: #00f2fe;
    }
    
    /* Instructions Bar */
    #instructions {
      position: absolute;
      bottom: calc(env(safe-area-inset-bottom, 20px) + 10px);
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
      background: rgba(10, 10, 15, 0.7);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      padding: 8px 18px;
      border-radius: 20px;
      font-size: 11px;
      color: #ccc;
      white-space: nowrap;
      border: 1px solid rgba(255, 255, 255, 0.08);
      pointer-events: none;
    }
  </style>

  <!-- External Libraries via CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>
</head>
<body>

  <!-- Web Audio & Camera Permission Overlay -->
  <div id="start-overlay">
    <div class="title">3D GESTURE PARTICLES</div>
    <div class="subtitle">Optimized for iPhone XS. Tap to enable Camera tracking and Audio reactivity.</div>
    <button class="btn-start" id="start-btn">START EXPERIENCE</button>
  </div>

  <!-- HUD Header -->
  <div id="hud">
    <div class="status-badge">
      <div class="dot" id="status-dot"></div>
      <span id="status-text">Hand: Searching</span>
    </div>
    <div class="status-badge" id="shape-indicator">Shape: SPHERE</div>
  </div>

  <div id="instructions">Pinch: Switch Model | Touch: Fallback</div>

  <!-- Main WebGL Container -->
  <div id="canvas-container"></div>
  
  <!-- Hidden Webcam Video for iOS -->
  <video id="webcam" playsinline webkit-playsinline muted></video>

  <script>
    const PARTICLE_COUNT = 3500;
    let scene, camera, renderer, particleSystem;
    let targetPositions = new Float32Array(PARTICLE_COUNT * 3);
    let currentPositions = new Float32Array(PARTICLE_COUNT * 3);
    
    const sphereShape = [];
    const carShape = [];
    const planeShape = [];
    let currentShapeIndex = 0;
    const shapeNames = ["SPHERE", "CAR OUTLINE", "JET OUTLINE"];

    let targetX = 0, targetY = 0;
    let isHandDetected = false;
    let lastPinchTime = 0;

    let audioCtx, analyser, dataArray;
    let audioReactiveScale = 1.0;

    const statusDot = document.getElementById('status-dot');
    const statusText = document.getElementById('status-text');
    const shapeIndicator = document.getElementById('shape-indicator');

    function initShapes() {
      for (let i = 0; i < PARTICLE_COUNT; i++) {
        // Shape 1: Sphere
        const u = Math.random();
        const v = Math.random();
        const theta = u * 2.0 * Math.PI;
        const phi = Math.acos(2.0 * v - 1.0);
        const r = Math.cbrt(Math.random()) * 2.2;
        sphereShape.push(
          r * Math.sin(phi) * Math.cos(theta),
          r * Math.sin(phi) * Math.sin(theta),
          r * Math.cos(phi)
        );

        // Shape 2: Car Outline
        let cx = (Math.random() - 0.5) * 4.5;
        let cy = (Math.random() - 0.5) * 1.5;
        let cz = (Math.random() - 0.5) * 2.2;
        if (cy > 0.3) cx *= 0.6;
        carShape.push(cx, cy, cz);

        // Shape 3: Jet Outline
        let px, py, pz;
        if (Math.random() < 0.5) {
          px = (Math.random() - 0.5) * 5.0;
          pz = (Math.random() - 0.5) * 1.2 - (Math.abs(px) * 0.4);
          py = (Math.random() - 0.5) * 0.3;
        } else {
          pz = (Math.random() - 0.5) * 5.5;
          px = (Math.random() - 0.5) * 0.8;
          py = (Math.random() - 0.5) * 0.8;
        }
        planeShape.push(px, py, pz);
      }
      setTargetShape(sphereShape);
    }

    function setTargetShape(shapeArray) {
      for (let i = 0; i < PARTICLE_COUNT * 3; i++) {
        targetPositions[i] = shapeArray[i];
      }
    }

    function initThreeJS() {
      const container = document.getElementById('canvas-container');
      
      scene = new THREE.Scene();
      scene.fog = new THREE.FogExp2(0x050508, 0.08);

      camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 100);
      camera.position.z = 6;

      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false, powerPreference: "high-performance" });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(renderer.domElement);

      const geometry = new THREE.BufferGeometry();
      for (let i = 0; i < PARTICLE_COUNT * 3; i++) {
        currentPositions[i] = targetPositions[i];
      }
      geometry.setAttribute('position', new THREE.BufferAttribute(currentPositions, 3));

      const material = new THREE.PointsMaterial({
        color: 0x00f2fe,
        size: 0.06,
        transparent: true,
        opacity: 0.85,
        blending: THREE.AdditiveBlending
      });

      particleSystem = new THREE.Points(geometry, material);
      scene.add(particleSystem);

      window.addEventListener('resize', onWindowResize);

      container.addEventListener('touchmove', (e) => {
        if (!isHandDetected && e.touches.length > 0) {
          const touch = e.touches[0];
          targetX = ((touch.clientX / window.innerWidth) - 0.5) * 5;
          targetY = -((touch.clientY / window.innerHeight) - 0.5) * 5;
        }
      }, { passive: true });
    }

    function onWindowResize() {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    }

    async function initAudio() {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const source = audioCtx.createMediaStreamSource(stream);
        analyser = audioCtx.createAnalyser();
        analyser.fftSize = 64;
        source.connect(analyser);
        dataArray = new Uint8Array(analyser.frequencyBinCount);
      } catch (err) {
        console.log("Audio not active:", err);
      }
    }

    function initHandTracking() {
      const videoElement = document.getElementById('webcam');

      const hands = new Hands({
        locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`
      });

      hands.setOptions({
        maxNumHands: 1,
        modelComplexity: 0,
        minDetectionConfidence: 0.5,
        minTrackingConfidence: 0.5
      });

      hands.onResults((results) => {
        if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
          isHandDetected = true;
          statusDot.classList.add('active');
          statusText.innerText = "Hand: Active";

          const hand = results.multiHandLandmarks[0];
          const indexTip = hand[8];
          const thumbTip = hand[4];

          targetX = -(indexTip.x - 0.5) * 6;
          targetY = -(indexTip.y - 0.5) * 6;

          const dx = indexTip.x - thumbTip.x;
          const dy = indexTip.y - thumbTip.y;
          const pinchDist = Math.sqrt(dx * dx + dy * dy);

          const now = Date.now();
          if (pinchDist < 0.08 && (now - lastPinchTime > 1000)) {
            lastPinchTime = now;
            cycleShape();
          }

        } else {
          isHandDetected = false;
          statusDot.classList.remove('active');
          statusText.innerText = "Hand: Searching";
        }
      });

      const cameraUtils = new Camera(videoElement, {
        onFrame: async () => {
          await hands.send({ image: videoElement });
        },
        width: 480,
        height: 360
      });

      cameraUtils.start();
    }

    function cycleShape() {
      currentShapeIndex = (currentShapeIndex + 1) % 3;
      shapeIndicator.innerText = "Shape: " + shapeNames[currentShapeIndex];
      
      if (currentShapeIndex === 0) setTargetShape(sphereShape);
      else if (currentShapeIndex === 1) setTargetShape(carShape);
      else if (currentShapeIndex === 2) setTargetShape(planeShape);
    }

    function animate() {
      requestAnimationFrame(animate);

      if (analyser) {
        analyser.getByteFrequencyData(dataArray);
        let bassSum = 0;
        for (let i = 0; i < 8; i++) bassSum += dataArray[i];
        const bassAvg = bassSum / 8;
        audioReactiveScale = 1.0 + (bassAvg / 255.0) * 0.4;
      }

      const posAttr = particleSystem.geometry.attributes.position;
      const positions = posAttr.array;

      for (let i = 0; i < PARTICLE_COUNT; i++) {
        const ix = i * 3;
        const iy = i * 3 + 1;
        const iz = i * 3 + 2;

        const tx = (targetPositions[ix] + targetX * 0.5) * audioReactiveScale;
        const ty = (targetPositions[iy] + targetY * 0.5) * audioReactiveScale;
        const tz = targetPositions[iz];

        positions[ix] += (tx - positions[ix]) * 0.04;
        positions[iy] += (ty - positions[iy]) * 0.04;
        positions[tz] += (tz - positions[iz]) * 0.04;
      }

      posAttr.needsUpdate = true;
      particleSystem.rotation.y += 0.005;

      renderer.render(scene, camera);
    }

    document.getElementById('start-btn').addEventListener('click', async () => {
      document.getElementById('start-overlay').style.display = 'none';
      initShapes();
      initThreeJS();
      await initAudio();
      initHandTracking();
      animate();
    });

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('./sw.js').catch(err => console.log(err));
      });
    }
  </script>
</body>
</html>